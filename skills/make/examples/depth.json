{
  "format": "ugoku-zukai/6",
  "title": "奥行きを足すと見えてくるもの",
  "voice": {
    "speaker": 8,
    "speed": 1.1
  },
  "values": {
    "yaw": 25,
    "pitch": 28,
    "a": 1.4,
    "b": -0.9,
    "rise": 0,
    "look": 0,
    "turn": 0,
    "gap": 1.4,
    "zoom": 92
  },
  "figures": {
    "cover": {
      "type": "title",
      "text": "奥行きを足すと\n見えてくるもの"
    },
    "screens": {
      "type": "compare",
      "items": [
        { "id": "page", "label": "商品ページ", "role": "actor" },
        { "id": "cart", "label": "カート", "role": "actor" },
        { "id": "order", "label": "注文画面", "role": "actor" }
      ]
    },
    "services": {
      "type": "compare",
      "items": [
        { "id": "stock", "label": "在庫の確保", "role": "process" },
        { "id": "charge", "label": "代金の請求", "role": "process" },
        { "id": "ship", "label": "発送の依頼", "role": "process" }
      ]
    },
    "stores": {
      "type": "compare",
      "items": [
        { "id": "items", "label": "商品と在庫", "role": "store" },
        { "id": "orders", "label": "注文", "role": "store" },
        { "id": "payments", "label": "支払い", "role": "store" }
      ]
    },
    "system": {
      "type": "graph",
      "direction": "right",
      "nodes": [
        { "id": "user", "label": "利用者", "role": "actor" },
        { "id": "server", "label": "注文サーバー", "role": "process", "inside": "server-inside" },
        { "id": "payment", "label": "決済サービス", "role": "external" }
      ],
      "edges": [
        { "from": "user", "to": "server", "label": "注文する" },
        { "from": "server", "to": "payment", "label": "代金を請求" }
      ]
    },
    "server-inside": {
      "type": "graph",
      "direction": "right",
      "nodes": [
        { "id": "web", "label": "Web", "role": "process" },
        { "id": "app", "label": "アプリ", "role": "process" },
        { "id": "db", "label": "注文 DB", "role": "store", "inside": "db-inside" }
      ],
      "edges": [
        { "from": "web", "to": "app", "label": "渡す" },
        { "from": "app", "to": "db", "label": "書く" }
      ]
    },
    "db-inside": {
      "type": "graph",
      "direction": "right",
      "nodes": [
        { "id": "index", "label": "索引", "role": "process" },
        { "id": "table", "label": "テーブル", "role": "store" }
      ],
      "edges": [
        { "from": "index", "to": "table", "label": "行の場所" }
      ]
    }
  },
  "slides": {
    "tangent-plane": {
      "title": "曲面と接平面",
      "statement": "接平面は、曲面の 1 点に接し、その点での曲面の傾きを表す平面です。",
      "parts": [
        {
          "id": "sp",
          "type": "space",
          "camera": { "yaw": "yaw", "pitch": "pitch", "scale": 85, "target": [0, 0, 1.1] },
          "bounds": { "min": [-2.4, -2.4, 0], "max": [2.4, 2.4, 3] },
          "items": [
            { "id": "dome", "kind": "surface", "f": "3 - (x*x + y*y)/4", "x": [-2.4, 2.4], "y": [-2.4, 2.4], "grid": 32, "color": "s1", "color2": "s3", "opacity": 0.9 },
            { "id": "plane", "kind": "surface", "f": "3.05 - (a*a + b*b)/4 - a/2*(x - a) - b/2*(y - b)", "x": ["a - 0.9", "a + 0.9"], "y": ["b - 0.9", "b + 0.9"], "grid": 16, "color": "s2", "opacity": 0.75 },
            { "id": "rim", "kind": "line", "color": "s2", "points": [
              ["a - 0.9", "b - 0.9", "3.05 - (a*a + b*b)/4 + 0.45*a + 0.45*b"], ["a + 0.9", "b - 0.9", "3.05 - (a*a + b*b)/4 - 0.45*a + 0.45*b"],
              ["a + 0.9", "b + 0.9", "3.05 - (a*a + b*b)/4 - 0.45*a - 0.45*b"], ["a - 0.9", "b + 0.9", "3.05 - (a*a + b*b)/4 + 0.45*a - 0.45*b"],
              ["a - 0.9", "b - 0.9", "3.05 - (a*a + b*b)/4 + 0.45*a + 0.45*b"] ] },
            { "id": "P", "kind": "point", "at": ["a", "b", "3.05 - (a*a + b*b)/4"], "color": "s4", "label": "P" }
          ]
        }
      ]
    },
    "layers": {
      "title": "Web サービスの 3 つの層",
      "statement": "画面・処理・データの 3 つの層が重なり、上の層は 1 つ下の層を使います。",
      "parts": [
        {
          "id": "stack",
          "type": "space",
          "camera": { "yaw": "turn", "pitch": "look", "scale": "zoom", "target": [0.3, -0.2, 1.8] },
          "items": [
            { "id": "screen-layer", "kind": "plate", "figure": "screens", "label": "画面", "labelWidth": 1.4, "fill": "muted", "opacity": 0.25, "origin": [-5.6, 0, "2 + gap"], "size": [11.8, 1.0], "tilt": "rise" },
            { "id": "service-layer", "kind": "plate", "figure": "services", "label": "処理", "labelWidth": 1.4, "fill": "muted", "opacity": 0.25, "origin": [-5.6, 0, 2], "size": [11.8, 1.0], "tilt": "rise" },
            { "id": "data-layer", "kind": "plate", "figure": "stores", "label": "データ", "labelWidth": 1.4, "fill": "muted", "opacity": 0.25, "origin": [-5.6, 0, "2 - gap"], "size": [11.8, 1.0], "tilt": "rise" },
            { "id": "call1", "kind": "arrow", "from": [-4.5, -1.15, "2 + gap - 0.15"], "to": [-4.5, -1.15, 2.15], "color": "s2" },
            { "id": "call2", "kind": "arrow", "from": [-4.5, -1.15, 1.85], "to": [-4.5, -1.15, "2.15 - gap"], "color": "s2" }
          ]
        }
      ]
    },
    "inside-server": {
      "title": "サーバーの中",
      "statement": "サーバーの箱 1 つの中に、Web・アプリ・DB が入っています。",
      "parts": [
        { "figure": "system" }
      ]
    }
  },
  "scenes": [
    {
      "id": "s1",
      "chapter": "c1",
      "figure": "cover",
      "lines": [
        {
          "id": "l1",
          "text": "平らな図に奥行きを足すと、正面からは分からなかった形や重なりが見えてきます。"
        }
      ]
    },
    {
      "id": "s2",
      "chapter": "c1",
      "slide": "tangent-plane",
      "lines": [
        {
          "id": "l2",
          "text": "{a}山のように盛り上がった曲面を描きます。",
          "do": [
            { "at": "a", "show": "dome", "draw": true }
          ]
        },
        {
          "id": "l3",
          "text": "{a}斜面の上に点 P を取り、{b}そこで曲面に接する平面を置きます。",
          "read": "{a}斜面の上に点ピーを取り、{b}そこで曲面に接する平面を置きます。",
          "do": [
            { "at": "a", "show": "P" },
            { "at": "b", "show": ["plane", "rim"] }
          ]
        },
        {
          "id": "l4",
          "text": "{a}真横から見ると、平面が曲面に触れているのは、点 P の 1 か所だけです。",
          "read": "{a}真横から見ると、平面が曲面に触れているのは、点ピーのいっかしょだけです。",
          "do": [
            { "at": "a", "set": "yaw", "to": -32.7, "dur": 2.4 },
            { "at": "a", "set": "pitch", "to": 0, "dur": 2.4 }
          ]
        },
        {
          "id": "l5",
          "text": "{a}点 P を頂上へ動かすと、接平面は水平になります。",
          "read": "{a}点ピーを頂上へ動かすと、接平面は水平になります。",
          "do": [
            { "at": "a", "set": "a", "to": 0, "dur": 2.0 },
            { "at": "a", "set": "b", "to": 0, "dur": 2.0 }
          ]
        },
        {
          "id": "l6",
          "text": "{a}反対側の斜面へ下りると、接平面は逆向きに傾きます。",
          "do": [
            { "at": "a", "set": "a", "to": -1.6, "dur": 2.0 },
            { "at": "a", "set": "b", "to": 1.03, "dur": 2.0 }
          ]
        },
        {
          "id": "l7",
          "text": "{a}斜め上から見直すと、点 P の近くでは、接平面と曲面がほとんど重なっています。",
          "read": "{a}斜め上から見直すと、点ピーの近くでは、接平面と曲面がほとんど重なっています。",
          "do": [
            { "at": "a", "set": "yaw", "to": -155, "dur": 3.0 },
            { "at": "a", "set": "pitch", "to": 28, "dur": 3.0 }
          ]
        }
      ]
    },
    {
      "id": "s3",
      "chapter": "c2",
      "slide": "layers",
      "lines": [
        {
          "id": "l8",
          "text": "{a}通販サイトの仕組みを、画面・処理・データの 3 段に分けて書きました。",
          "do": [
            { "at": "a", "show": ["screen-layer", "service-layer", "data-layer"] }
          ]
        },
        {
          "id": "l9",
          "text": "{a}この 3 段を起こして斜め上から見ると、上下に重なった層だと分かります。",
          "do": [
            { "at": "a", "set": "rise", "to": 90, "dur": 2.6 },
            { "at": "a", "set": "look", "to": 60, "dur": 2.6 },
            { "at": "a", "set": "turn", "to": -8, "dur": 2.6 },
            { "at": "a", "set": "gap", "to": 2.4, "dur": 2.6 },
            { "at": "a", "set": "zoom", "to": 80, "dur": 2.6 }
          ]
        },
        {
          "id": "l10",
          "text": "{a}画面は処理を呼び、{b}処理はデータを読み書きします。",
          "do": [
            { "at": "a", "show": "call1", "draw": true },
            { "at": "b", "show": "call2", "draw": true }
          ]
        },
        {
          "id": "l11",
          "text": "{a}ここで、処理の層だけを作り直すとします。",
          "do": [
            { "at": "a", "focus": "service-layer" }
          ]
        },
        {
          "id": "l12",
          "text": "上下の層とやり取りする形が同じなら、ほかの層は変えずに済みます。"
        }
      ]
    },
    {
      "id": "s4",
      "chapter": "c3",
      "slide": "inside-server",
      "lines": [
        {
          "id": "l13",
          "text": "{a}利用者の注文は、サーバーを通って、決済サービスに届きます。",
          "do": [
            { "at": "a", "show": "system" }
          ]
        },
        {
          "id": "l14",
          "text": "{a}サーバーに寄ると、箱の中の部品が見えてきます。",
          "do": [
            { "at": "a", "zoom": "server" }
          ]
        },
        {
          "id": "l15",
          "text": "{a}Web で受けた注文を、アプリが処理して、DB に書き込みます。",
          "read": "{a}ウェブで受けた注文を、アプリが処理して、デービーに書き込みます。",
          "do": [
            { "at": "a", "trace": ["web", "app", "db"], "label": "注文", "dot": "request" }
          ]
        },
        {
          "id": "l16",
          "text": "{a}さらに DB に寄ると、索引とテーブルに分かれています。",
          "read": "{a}さらにデービーに寄ると、索引とテーブルに分かれています。",
          "do": [
            { "hide": "dot:request" },
            { "at": "a", "zoom": "db" }
          ]
        },
        {
          "id": "l17",
          "text": "{a}索引で行の場所を調べてから、テーブルの行を読みます。",
          "do": [
            { "at": "a", "trace": ["index", "table"], "label": "検索", "dot": "lookup" }
          ]
        },
        {
          "id": "l18",
          "text": "{a}全体に戻ると、ここまで見た部品は、サーバーの箱 1 つに収まっています。",
          "do": [
            { "hide": "dot:lookup" },
            { "at": "a", "zoom": "all" }
          ]
        },
        {
          "id": "l19",
          "text": "回り込む、起こす、中へ入る。この 3 つの動きで、平らな図では見えなかった形や重なり、箱の中身が見えてきます。"
        }
      ]
    }
  ]
}
