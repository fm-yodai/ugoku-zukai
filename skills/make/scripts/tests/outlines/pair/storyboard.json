{
  "format": "ugoku-zukai/2",
  "title": "経費精算の進め方を選ぶ",
  "voice": {
    "speaker": 8,
    "speed": 1.1
  },
  "figures": {
    "issues": {
      "type": "list",
      "title": "いまの困りごと",
      "numbered": true,
      "items": [
        {
          "id": "i1",
          "text": "紙の領収書を毎月まとめて提出している",
          "sub": "月末に経理の作業が集中する"
        },
        {
          "id": "i2",
          "text": "承認者が不在だと止まる"
        },
        {
          "id": "i3",
          "text": "どこで止まっているか誰にも見えない"
        }
      ]
    },
    "plans": {
      "type": "compare",
      "title": "二つの案",
      "items": [
        {
          "id": "a",
          "label": "A案 クラウドの精算サービス",
          "role": "actor",
          "points": [
            {
              "text": "スマホで領収書を撮って申請",
              "kind": "pro"
            },
            {
              "text": "代理承認を設定できる",
              "kind": "pro"
            },
            {
              "text": "月額の利用料がかかる",
              "kind": "con"
            }
          ]
        },
        {
          "id": "b",
          "label": "B案 いまの表計算を改良",
          "role": "external",
          "points": [
            {
              "text": "追加の費用はかからない",
              "kind": "pro"
            },
            {
              "text": "紙の提出は残る",
              "kind": "con"
            },
            {
              "text": "止まった場所は見えないまま",
              "kind": "con"
            }
          ]
        }
      ]
    },
    "tbl": {
      "type": "table",
      "title": "困りごとへの効き方",
      "columns": [
        {
          "id": "issue",
          "label": "困りごと"
        },
        {
          "id": "a",
          "label": "A案"
        },
        {
          "id": "b",
          "label": "B案"
        }
      ],
      "rows": [
        {
          "id": "r1",
          "cells": [
            "紙の提出",
            {
              "text": "なくなる",
              "mark": "check"
            },
            {
              "text": "残る",
              "mark": "cross"
            }
          ]
        },
        {
          "id": "r2",
          "cells": [
            "承認者の不在",
            {
              "text": "代理承認",
              "mark": "check"
            },
            "変わらない"
          ]
        },
        {
          "id": "r3",
          "cells": [
            "止まった場所",
            {
              "text": "画面で見える",
              "mark": "check"
            },
            "見えない"
          ]
        },
        {
          "id": "r4",
          "cells": [
            "費用",
            "月額がかかる",
            {
              "text": "かからない",
              "mark": "check"
            }
          ]
        }
      ]
    }
  },
  "scenes": [
    {
      "id": "s1",
      "chapter": "c1",
      "figure": "issues",
      "lines": [
        {
          "id": "l1",
          "text": "いまの経費精算には、{a}三つの困りごとがあります。",
          "do": [
            {
              "at": "a",
              "show": "issues"
            }
          ]
        },
        {
          "id": "l2",
          "text": "中でも大きいのは、{a}どこで止まっているかが見えないことです。",
          "do": [
            {
              "at": "a",
              "focus": "i3"
            },
            {
              "pulse": "i3"
            }
          ]
        }
      ]
    },
    {
      "id": "s2",
      "chapter": "c2",
      "figure": "plans",
      "lines": [
        {
          "id": "l3",
          "text": "解決の案は{a}二つあります。順に見ていきましょう。",
          "do": [
            {
              "at": "a",
              "show": "plans"
            }
          ]
        },
        {
          "id": "l4",
          "text": "{a}A案は費用がかかりますが、紙と待ち時間の両方を減らせます。",
          "read": "{a}エーあんは費用がかかりますが、紙と待ち時間の両方を減らせます。",
          "do": [
            {
              "at": "a",
              "focus": "a"
            }
          ]
        },
        {
          "id": "l5",
          "text": "{a}B案は費用がかからない代わりに、困りごとの多くが残ります。",
          "read": "{a}ビーあんは費用がかからない代わりに、困りごとの多くが残ります。",
          "do": [
            {
              "at": "a",
              "focus": "b"
            }
          ]
        }
      ]
    },
    {
      "id": "s3",
      "chapter": "c2",
      "figure": "tbl",
      "lines": [
        {
          "id": "l6",
          "text": "困りごとごとに{a}並べると、違いがはっきりします。",
          "do": [
            {
              "at": "a",
              "show": "tbl",
              "stagger": 0.12
            }
          ]
        },
        {
          "id": "l7",
          "text": "{a}A案は三つの困りごとすべてに効き、{b}B案が勝るのは費用だけです。",
          "read": "{a}エーあんは三つの困りごとすべてに効き、{b}ビーあんが勝るのは費用だけです。",
          "do": [
            {
              "at": "a",
              "focus": [
                "a",
                "issue"
              ]
            },
            {
              "at": "b",
              "focus": [
                "r4"
              ]
            },
            {
              "mark": "r4",
              "as": "question"
            }
          ]
        }
      ]
    }
  ]
}
