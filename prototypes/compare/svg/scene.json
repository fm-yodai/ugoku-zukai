{
  "map": {
    "title": "経費申請の流れ",
    "direction": "RIGHT",
    "layers": [
      {"id": "l_req", "name": "申請する人", "members": ["app"]},
      {"id": "l_sys", "name": "経費システム", "members": ["sys"]},
      {"id": "l_apr", "name": "承認する人", "members": ["kacho", "bucho"]},
      {"id": "l_acc", "name": "支払い", "members": ["keiri"]}
    ],
    "nodes": [
      {"id": "app", "name": "申請者", "kind": "actor"},
      {"id": "sys", "name": "入力チェック", "kind": "process"},
      {"id": "kacho", "name": "課長", "kind": "actor"},
      {"id": "bucho", "name": "部長", "kind": "actor"},
      {"id": "keiri", "name": "経理", "kind": "external"}
    ],
    "edges": [
      {"id": "app>sys", "label": "申請を送る"},
      {"id": "sys>kacho", "label": "10万円まで"},
      {"id": "sys>bucho", "label": "10万円超"},
      {"id": "kacho>keiri", "label": "承認を通知"},
      {"id": "bucho>keiri", "label": "承認を通知"}
    ]
  },
  "lines": [
    {"id": "c1-1", "ops": [{"op": "map_show"}]},
    {"id": "c1-2", "ops": [
      {"op": "dot", "id": "req", "at_edge": "app>sys", "tag": "申請 3万円"},
      {"op": "travel", "dot": "req", "path": ["sys"]},
      {"op": "pulse", "target": "sys", "at": "、1"}
    ]},
    {"id": "c1-3", "ops": [
      {"op": "respond", "from": "req", "id": "back", "label": "差し戻し", "color": "removed", "at": 0.3}
    ]},
    {"id": "c1-4", "ops": [
      {"op": "dim", "ids": ["back"]},
      {"op": "highlight", "target": "sys>kacho", "at": "、1"},
      {"op": "dim", "ids": ["bucho", "sys>bucho", "bucho>keiri"], "with_prev": true},
      {"op": "travel", "dot": "req", "path": ["sys", "kacho"], "dur": 1.6}
    ]},
    {"id": "c1-5", "ops": [
      {"op": "travel", "dot": "req", "path": ["kacho", "keiri"], "at": 0.3, "dur": 1.5},
      {"op": "pulse", "target": "keiri"},
      {"op": "badge", "target": "keiri", "text": "支払い予定"}
    ]}
  ]
}
